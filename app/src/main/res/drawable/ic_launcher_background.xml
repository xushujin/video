<?xml version="1.0" encoding="utf-8"?>
<!--
  图标底层：一整片哑光面，只有左上 → 右下的缓慢明暗过渡。

  不画「底板 + 圆盘」两层边界 —— 光源只有一个，体积靠渐变塑造，
  所以背景只负责给圆盘一个同材质的落脚面。

  配色取自**浅色外壳**（LightShell）：背景 #EDEFF3 / 阴影 #C2C8D2。
  这里的渐变两端都比原值暗一点，给上层的亮面圆盘留出对比余量。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FFEAEEF4"
        android:endColor="#FFD5DBE6" />
</shape>
