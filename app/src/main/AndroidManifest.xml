<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      零存储权限：视频目录通过 SAF(ACTION_OPEN_DOCUMENT_TREE) 授权并持久化，
      不需要 READ_MEDIA_VIDEO / READ_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE。

      下面三条是「后台播放音频」需要的：前台服务 + 媒体播放类型 + 持锁解码。
      没有它们，切后台或息屏后播放会被系统掐掉。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      刻意声明但不申请：Android 13+ 上不弹权限框、通知栏里没有播放控件。
      但这**不影响后台播放** —— 前台服务本身照常运行，只是通知不可见。
      想要通知控件的用户可以在系统设置里手动打开，媒体通知会立刻出现。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      应用内更新需要的两条：
      - INTERNET：只用于「检查更新」拉 GitHub Releases 和下载 APK，没有在线播放。
      - REQUEST_INSTALL_PACKAGES：Android 8+ 调起安装器需要；用户还要在系统设置里
        为「轻影」打开「安装未知应用」，否则安装会被系统拦下。
      两者都是安装期权限，不弹运行时权限框。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".QingYingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QingYing">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.QingYing"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 把下载好的 APK 以 content:// 交给系统安装器，避免暴露 file:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
